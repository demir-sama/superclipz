# --- Frontend (exposed to browser, VITE_ prefix) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Base URL of the FFmpeg clipper service in /server (e.g. https://superclipz-api.onrender.com). Empty = use ffmpeg.wasm in browser.
VITE_API_URL=
VITE_SITE_URL=

# --- Vercel serverless (secret, server only) ---
# OpenAI or any Whisper/Chat-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TRANSCRIBE_MODEL=whisper-1
CAPTION_MODEL=gpt-4o-mini
# Optional default Discord webhook for "share to Discord"
DISCORD_WEBHOOK_URL=

# --- /server (FFmpeg service) ---
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173
